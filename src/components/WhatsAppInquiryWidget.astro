---
import { siteConfig } from '../site.config';
import { buildWhatsAppUrl } from '../lib/whatsapp';

interface Props {
  initialGuests?: number;
  class?: string;
}

const { initialGuests = 2, class: className = '' } = Astro.props;
const defaultUrl = buildWhatsAppUrl(siteConfig.contact.whatsappNumber, {
  hostName: siteConfig.contact.hostName,
  guests: initialGuests,
});
---

<div
  class={`bg-white rounded-2xl shadow-xl border border-stone-200 p-6 sm:p-8 ${className}`}
  data-whatsapp-widget
  data-phone={siteConfig.contact.whatsappNumber}
  data-host={siteConfig.contact.hostName}
>
  <div class="flex items-center justify-between mb-6 pb-4 border-b border-stone-100">
    <div>
      <span class="text-xs font-semibold tracking-wider uppercase text-brand-600 block">Direct Booking Guarantee</span>
      <h3 class="text-xl font-bold text-stone-900">Check Availability & Save 18%</h3>
    </div>
    <div class="text-right">
      <span class="text-xs text-stone-500 block">From</span>
      <span class="text-2xl font-extrabold text-stone-900">{siteConfig.pricing.currencySymbol}{siteConfig.pricing.baseRatePerNight.toLocaleString('en-IN')}</span>
      <span class="text-xs text-stone-500">/ night</span>
    </div>
  </div>

  <form class="space-y-4" onsubmit="return false;">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <label for="widget-checkin" class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1">
          Check-in
        </label>
        <input
          type="date"
          id="widget-checkin"
          name="checkin"
          class="w-full px-3 py-2.5 rounded-lg border border-stone-300 text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
        />
      </div>

      <div>
        <label for="widget-checkout" class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1">
          Check-out
        </label>
        <input
          type="date"
          id="widget-checkout"
          name="checkout"
          class="w-full px-3 py-2.5 rounded-lg border border-stone-300 text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
        />
      </div>
    </div>

    <div>
      <label for="widget-guests" class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-1">
        Guests (Max {siteConfig.specs.maxGuests})
      </label>
      <select
        id="widget-guests"
        name="guests"
        class="w-full px-3 py-2.5 rounded-lg border border-stone-300 text-stone-800 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
      >
        {Array.from({ length: siteConfig.specs.maxGuests }, (_, i) => i + 1).map((num) => (
          <option value={num} selected={num === initialGuests}>
            {num} {num === 1 ? 'Guest' : 'Guests'}
          </option>
        ))}
      </select>
    </div>

    <div class="pt-2">
      <a
        id="widget-submit-btn"
        href={defaultUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-ga-cta="widget_whatsapp_inquiry"
        class="w-full inline-flex items-center justify-center gap-3 bg-brand-600 hover:bg-brand-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-brand-500/25 transition text-base group"
      >
        <svg class="w-5 h-5 fill-current transition group-hover:scale-110" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.127-.518-1.724-.713-2.827-2.47-2.913-2.584-.086-.115-.696-.927-.696-1.768 0-.841.44-1.254.596-1.426.156-.172.34-.216.455-.216.115 0 .23 0 .33.006.106.005.25.04.385.367.144.348.49 1.196.533 1.282.043.086.072.187.014.302-.058.115-.087.187-.173.287-.086.101-.182.226-.26.303-.087.086-.177.18-.076.353.101.173.45 1.742 1.745 2.197.354.124.56.102.72-.083.201-.23.864-1.006.864-1.006.13-.158.26-.13.433-.072.173.058 1.096.517 1.284.61.187.094.312.14.358.217.046.077.046.446-.098.851z"/>
        </svg>
        <span>Check Availability on WhatsApp</span>
      </a>
      <p class="text-center text-xs text-stone-500 mt-2">
        Instant reply from host • No platform commission • Best price guaranteed
      </p>
    </div>
  </form>
</div>

<script>
  import { buildWhatsAppUrl } from '../lib/whatsapp';

  function initWidgets() {
    const widgets = document.querySelectorAll('[data-whatsapp-widget]');

    widgets.forEach((widget) => {
      const phone = widget.getAttribute('data-phone') || '';
      const host = widget.getAttribute('data-host') || '';
      const checkinInput = widget.querySelector('#widget-checkin') as HTMLInputElement | null;
      const checkoutInput = widget.querySelector('#widget-checkout') as HTMLInputElement | null;
      const guestsInput = widget.querySelector('#widget-guests') as HTMLSelectElement | null;
      const submitBtn = widget.querySelector('#widget-submit-btn') as HTMLAnchorElement | null;

      if (!submitBtn) return;

      // Set min date to today for check-in
      const today = new Date().toISOString().split('T')[0];
      if (checkinInput && !checkinInput.min) checkinInput.min = today;
      if (checkoutInput && !checkoutInput.min) checkoutInput.min = today;

      function updateHref() {
        const checkIn = checkinInput?.value || undefined;
        const checkOut = checkoutInput?.value || undefined;
        const guests = guestsInput ? parseInt(guestsInput.value, 10) : 2;

        if (checkinInput && checkoutInput && checkinInput.value) {
          checkoutInput.min = checkinInput.value;
        }

        const url = buildWhatsAppUrl(phone, {
          hostName: host,
          checkIn,
          checkOut,
          guests,
        });

        submitBtn!.href = url;
      }

      checkinInput?.addEventListener('change', updateHref);
      checkoutInput?.addEventListener('change', updateHref);
      guestsInput?.addEventListener('change', updateHref);
    });
  }

  // Run on mount and Astro page swap
  initWidgets();
  document.addEventListener('astro:page-load', initWidgets);
</script>
