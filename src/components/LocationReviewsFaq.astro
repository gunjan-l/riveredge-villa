---
import { siteConfig } from '../site.config';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const directFaqUrl = buildWhatsAppUrl(siteConfig.contact.whatsappNumber, {
  hostName: siteConfig.contact.hostName,
});
---

<section id="location" class="py-16 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Location & Map -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-20">
      <div class="lg:col-span-5 space-y-4">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-widest">Tranquil Riverside Setting</span>
        <h2 class="text-3xl font-extrabold text-stone-900">
          Easy Drive from Mumbai & Pune
        </h2>
        <p class="text-stone-600 leading-relaxed text-sm sm:text-base">
          Tucked away on private riverbanks along the Pej River in Karjat. Accessible via smooth scenic roads with private gated parking for up to 5 cars.
        </p>

        <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-sm space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-stone-500">Key Distances & Travel Time</h4>
          <ul class="space-y-2 text-sm">
            {siteConfig.location.nearbyLandmarks.map((lm) => (
              <li class="flex items-center justify-between py-1 border-b border-stone-100 last:border-0">
                <span class="font-medium text-stone-800">{lm.name}</span>
                <span class="text-xs text-stone-500 font-semibold">{lm.distance}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-7 h-80 sm:h-96 rounded-2xl overflow-hidden shadow-lg border border-stone-200">
        <iframe
          src={siteConfig.location.googleMapsEmbedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Location map of ${siteConfig.name}`}
          class="w-full h-full"
        ></iframe>
      </div>
    </div>

    <!-- Verified Reviews -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-semibold mb-2">
          ★ {siteConfig.contact.airbnbRating} Average Airbnb Rating
        </div>
        <h3 class="text-3xl font-extrabold text-stone-900">Loved by Over 140+ Guests</h3>
        <p class="text-stone-600 text-sm mt-2">Authentic reviews from verified Airbnb travelers who stayed at Riveredge Villa.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {siteConfig.reviews.map((rev) => (
          <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1 text-amber-400 mb-3">
                {Array.from({ length: rev.rating }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-stone-700 text-sm leading-relaxed italic mb-4">"{rev.content}"</p>
            </div>

            <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
              <div>
                <p class="text-sm font-bold text-stone-900">{rev.author}</p>
                <p class="text-xs text-stone-400">{rev.date}</p>
              </div>
              {rev.verifiedAirbnbGuest && (
                <span class="inline-flex items-center text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                  Verified Stay
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Collapsible FAQ -->
    <div id="faq" class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-widest">Clear Policies & Answers</span>
        <h3 class="text-3xl font-extrabold text-stone-900 mt-1">Frequently Asked Questions</h3>
      </div>

      <div class="space-y-4">
        {siteConfig.faqs.map((faq, idx) => (
          <details class="group bg-white rounded-xl border border-stone-200 p-5 shadow-sm transition [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-stone-900 text-base select-none">
              <span>{faq.question}</span>
              <span class="transition duration-300 group-open:rotate-180 text-stone-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-stone-600 text-sm leading-relaxed border-t border-stone-100 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>

      <!-- End of FAQ CTA -->
      <div class="mt-12 text-center bg-stone-900 text-white rounded-2xl p-8">
        <h4 class="text-xl font-bold mb-2">Have a question not answered here?</h4>
        <p class="text-stone-300 text-sm mb-6 max-w-md mx-auto">
          Host {siteConfig.contact.hostName} is available 24/7 on WhatsApp for customized requests, food menus, and special dates.
        </p>
        <a
          href={directFaqUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-ga-cta="faq_footer_whatsapp"
          class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-bold px-6 py-3 rounded-xl shadow-md transition"
        >
          <span>Chat Directly on WhatsApp</span>
        </a>
      </div>

    </div>

  </div>
</section>
